# Dependencies
node_modules/
package-lock.json

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Sensitive data files - user specific
bennyshub/apps/tools/messenger/config.json
bennyshub/apps/tools/messenger/dm_index.json
bennyshub/apps/tools/messenger/messenger_settings.json
bennyshub/apps/tools/messenger/processed_dm_ids.json
bennyshub/apps/tools/messenger/read_state*.json
bennyshub/apps/tools/messenger/recent_messages*.json
bennyshub/apps/tools/messenger/*.lock

# Journal entries
bennyshub/apps/tools/journal/entries.json

# Search history
bennyshub/apps/tools/search/search_history.json
bennyshub/apps/tools/streaming/search_history.json

# API keys
bennyshub/apps/tools/streaming/timd-api.json
bennyshub/apps/tools/messenger/ai_key.json
bennyshub/apps/tools/messenger/keyboard_context*.json
bennyshub/apps/tools/messenger/processed_dm_ids*.json
bennyshub/apps/tools/rt-convo/api.txt
bennyshub/apps/tools/rt-convo/context.json
bennyshub/apps/tools/rt-convo/google-credentials.json

# Streaming user data (contains Plex server IDs and watch history)
bennyshub/apps/tools/streaming/data.json
bennyshub/apps/tools/streaming/episodes.json
bennyshub/apps/tools/streaming/data/*.json
bennyshub/apps/tools/streaming/data/*.xlsx

# Voice settings (may contain user preferences)
bennyshub/shared/voice-settings.json

# Predictive-text corpus (real typed words/phrases - not for public repo).
# Glob covers any export/variant filename (e.g. predictive_ngrams_predictions.json,
# backup copies) - only the checked-in blank predictive_ngrams.example.json is exempt.
bennyshub/shared/predictive_ngrams*.json
!bennyshub/shared/predictive_ngrams.example.json

# Games are sourced live from bennyshub.com and cached locally on demand -
# see games.json / README for the sync mechanism. Never commit game folders here.
bennyshub/apps/games/*/
!bennyshub/apps/games/games.json

# Logs
*.log
crash.log

# Runtime signal files
bennyshub/nav_signal.json
bennyshub/apps/nav_signal.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
